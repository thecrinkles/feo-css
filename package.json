{
  "scripts": {
    "css:core": "lightningcss --bundle --minify --targets '> 1% and last 3 versions' src/feo.css -o feo.min.css",
    "css:docs": "pnpm css:core && copyfiles -f ./*.min.css public",
    "build": "pnpm css:core",
    "start": "eleventy --serve & pnpm css:docs & onchange 'src/**/*.css' -- pnpm css:docs",
    "build:11ty": "pnpm css:docs && eleventy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "name": "feo-css",
  "version": "6.0.0-beta.16",
  "main": "feo.css",
  "type": "module",
  "description": "A tiny CSS framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interruptd/feo-css.git"
  },
  "keywords": [
    "cube css",
    "css"
  ],
  "author": "Kevin Pennekamp <kevin@interrupted.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/interruptd/feo-css/issues"
  },
  "homepage": "https://github.com/interruptd/feo-css#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "copyfiles": "^2.4.1",
    "lightningcss-cli": "^1.33.0",
    "onchange": "^7.1.0",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@12.6.0"
}
