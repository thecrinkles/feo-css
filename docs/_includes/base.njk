<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="text-scale" content="scale" />
    <title>{{ title }} - {{ metadata.title }}</title>
    <link rel="stylesheet" href="/feo.min.css" />
    <link rel="stylesheet" href="/demo.css" />
    <script src="/js/search.js" type="module"></script>
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href="{{ metadata.url }}{{ page.url }}" />
    <link
      rel="alternate"
      type="text/markdown"
      href="{{ metadata.url }}{{ page.filePathStem }}.md"
    />
    <meta
      name="description"
      content="{{ description or metadata.description }}"
    />
    <meta property="og:site_name" content="{{ metadata.title }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ metadata.url }}{{ page.url }}" />
    <meta property="og:title" content="{{ title }} - {{ metadata.title }}" />
    <meta
      property="og:description"
      content="{{ description or metadata.description }}"
    />
    <meta name="fediverse:creator" content="@crinkles@front-end.social" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#F7F9FB"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0E131B"
    />
  </head>

  <body class="sidebar --left">
    <div class="sidebar --left">
      <!-- SIDEBAR -->
      <nav class="flex --column | self-start">
        <div class="flex --column --center">
          {% include "svg/logo.svg" %}
          <span class="italic" style="font-size: var(--p-size--1)">v{{ pkg.version }}</span>
        </div>
        <search hidden>
          <label for="docs-search" class="visually-hidden">Search the docs</label>
          <input type="search" id="docs-search" placeholder="Search…" autocomplete="off" data-search-input />
        </search>
        <div data-search-default>{% include "partials/navigation.njk" %}</div>
        <ul role="list" class="flow" data-search-results hidden></ul>
        <p data-search-empty hidden>No matching pages.</p>
      </nav>
      <!-- CONTENT -->
      <div class="flex --column">
        <main class="flex --column --center">
          <article class="flow">
            <div class="repel --center | doc-bar">
              {% include "partials/breadcrumb.njk" %}
              {% if github %}
                <a href="https://github.com/thecrinkles/feo-css/blob/main/src/{{parent}}/{{key}}.css" target="_blank" >
                  Source
                </a>
              {% endif %}
            </div>
            <h1>{{title}}</h1>
            {{ content | safe }}

              <div class="repel | doc-bar" style="margin-block-start: var(--p-size-2)">
                {% set previousPost = collections.docs | getPreviousCollectionItem(page) %}
                {% set nextPost = collections.docs | getNextCollectionItem(page) %}

                {% if previousPost %}<a href="{{ previousPost.url }}">← {{ previousPost.data.parent }}: {{ previousPost.data.title }}</a>{% else %}<div></div>{% endif %}
                {% if nextPost %}<a href="{{ nextPost.url }}">{{ nextPost.data.parent }}: {{ nextPost.data.title }} →</a>{% else %}<div></div>{% endif %}
              </div>
          </article>
        </main>
        {% include "partials/footer.njk" %}
      </div>
    </div>
  </body>
</html>
